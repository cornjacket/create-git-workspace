# task-config.sh — GENERATED by create-project-system. Do not hand-edit.
#
# Rendered from task-config.sh.in and placed beside the task scripts. It is the
# single source of truth for where the task subsystem is mounted — no script may
# hardcode the mount path.
#
# Sourced by task-env.sh.

# Mount path of the task subsystem, relative to the repo root (e.g. "tasks",
# "pm/tasks", ".tasks"). No leading or trailing slash.
TASKS_REL="{{TASKS_REL}}"

# Default epic used when a script is invoked without --epic.
DEFAULT_EPIC="{{DEFAULT_EPIC}}"

# Mount path for the optional "projects" layer (long-running services), relative
# to the repo root. Emitted only when the generator is run with --with-projects.
# If left unset, task-env.sh derives a sibling of TASKS_REL:
#   tasks -> projects  |  pm/tasks -> pm/projects
{{PROJECTS_REL_LINE}}
